# LLM - Ollama (gemma4:31b-cloud is an Ollama CLOUD model, not fully local)
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_BASE_URL=http://localhost:11434

# Optional overrides (defaults shown)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional: Hugging Face access token (https://huggingface.co/settings/tokens).
# NOT required - both models are public - but it lifts rate limits and speeds
# up model downloads. A read token is enough.
# HF_TOKEN=hf_xxxxxx

# Auth: CSV user registry (seeded with demo accounts if missing)
# USERS_CSV_PATH=users.csv
# TOKEN_TTL_SECONDS=0   # 0 = tokens never expire

# Calendar agent (calendar_agent.py): real Google Calendar via MCP.
# Obtain the refresh token with: python google_calendar_auth.py --client-id ... --client-secret ...
# Without these, the agent falls back to a local MOCK calendar server.
GOOGLE_CALENDAR_MCP_URL=https://api.google.com/mcp/calendar/v1/sse
# GOOGLE_CALENDAR_ACCESS_TOKEN=...
# GOOGLE_CALENDAR_REFRESH_TOKEN=...
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
